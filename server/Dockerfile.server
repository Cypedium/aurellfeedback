FROM node:22-slim

WORKDIR /server

# Install dependencies first so this layer is cached between code changes
COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

# Secrets (MONGO_URI, JWT_SECRET, REFRESH_SECRET, CLIENT_URL) come from `fly secrets`
ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

USER node

CMD ["node", "server.js"]
